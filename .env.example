# ==============================================================================
# DeFAI Sentinel — Environment Configuration
# ==============================================================================

# Database Configuration (MySQL required by PRD)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/defai_sentinel

# Optional fallback database URL if MySQL is in the middle of setup
FALLBACK_SQLITE_URL=sqlite:///./defai_sentinel.db

# Server Configuration
HOST=127.0.0.1
PORT=5001
DEBUG=True

# AI Reasoning Configuration (Local Ollama via OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=richardyoung/qwen2.5-14b-instruct-abliterated
AI_TIMEOUT_SECONDS=10

# Blockchain / EVM Configuration (Local Anvil / Hardhat / Testnet)
EVM_RPC_URL=http://127.0.0.1:8545
DEFAI_POLICY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Test / Agent EOA keys for local Anvil network (never use production keys)
AGENT_WALLET_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
USER_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
