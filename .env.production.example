# ==============================================================================
# DeFAI Sentinel — Production Environment Template (.env.production.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# ==============================================================================

# Environment Tier (production)
ENVIRONMENT=production

# Database Configuration (Managed MySQL 8.0 with SSL)
DATABASE_URL=mysql+pymysql://defai_prod_user:COMPLEX_PASSWORD@your-mysql-rds-or-cloud-sql:3306/defai_sentinel?ssl_ca=/etc/ssl/certs/rds-ca-2019.pem

# Server Configuration
HOST=0.0.0.0
PORT=5001
DEBUG=False

# Payment Gateway Configuration (Production Live Mode)
# CRITICAL REQUIREMENT: ALLOW_LIVE_PAYMENTS must only be set to True after
# merchant business verification, KYC, RBI 2FA mandate testing, and legal compliance sign-off.
PAYMENT_MODE=live
ALLOW_LIVE_PAYMENTS=False
RAZORPAY_KEY_ID=rzp_live_PROD_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PROD_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=PROD_WEBHOOK_SECRET_HERE

# E-Commerce Product Data Configuration
ECOMMERCE_PROVIDER=authorized_catalog
ECOMMERCE_API_KEY=PROD_PARTNER_API_KEY
ECOMMERCE_API_ENDPOINT=https://api.merchant-partner.com/v1

# AI Engine (Self-Hosted Private vLLM / Ollama or Azure OpenAI)
OLLAMA_BASE_URL=https://ai-inference.internal.defai-sentinel.com/v1
OLLAMA_API_KEY=SECURE_INTERNAL_BEARER_TOKEN
OLLAMA_MODEL=qwen2.5-14b-instruct
AI_TIMEOUT_SECONDS=10

# Blockchain / EVM Configuration (Base / Polygon / Ethereum Mainnet RPC)
EVM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
DEFAI_POLICY_CONTRACT_ADDRESS=0xPROD_DEPLOYED_CONTRACT_ADDRESS
AGENT_WALLET_ADDRESS=0xPROD_AGENT_WALLET
USER_WALLET_ADDRESS=0xPROD_USER_WALLET
